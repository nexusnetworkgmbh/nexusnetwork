# Local: http://localhost:3001. Production behind same-domain reverse proxy:
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_WEBSITE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Not used by normal portal requests. Never NEXT_PUBLIC, never commit.
SUPABASE_SECRET_KEY=
# Enable only AFTER provider configuration has been verified in Supabase.
AUTH_GOOGLE_ENABLED=
AUTH_APPLE_ENABLED=
